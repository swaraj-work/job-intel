# Copy to .env for local use. On Railway, set these in the service's Variables tab instead (never commit .env).
# The engine uses its rules extractor when optional LLM keys are absent.

# --- Google sign-in ---
# Set both credentials from a Google OAuth Web application client.
# Register the exact redirect URI: <APP_ORIGIN>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# APP_ORIGIN=http://localhost:4300
# On Railway, use the service's public HTTPS origin. Do not include a path.

# --- Optional integrations ---
# When configured, these keys also enable their built-in discovery sources by default.
X_BEARER_TOKEN=
SERPAPI_API_KEY=
# LLM (optional). Turns on LLM extraction, outreach angles and agent query planning.
# Groq is used when its key is set (fast; free key: https://console.groq.com/keys), otherwise Gemini.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=groq   # force one provider when both keys are set

# Strongly recommended on Railway: anonymous Reddit RSS is often blocked from datacenter IPs.
# Free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: verified work-email lookup for decision makers (pick one or both; only verified addresses are stored).
# Apollo (better coverage of Indian startups): https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=
# Hunter (cheaper to start): https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Server ---
# Railway injects PORT itself; only set it locally (default 4300).
PORT=4300
# HOST=            unset = loopback locally, all interfaces when on Railway
# DB_PATH=         unset = data/jobintel.db locally, <volume>/jobintel.db on Railway
# WORKSPACE_DIR=   unset = <DB_PATH>.workspaces
# LLM_SHARED_DAILY_CAP=300
# EMAIL_SHARED_DAILY_CAP=25
# SPROUTS_SHARED_DAILY_CAP=25
# DATAFORSEO_SHARED_DAILY_CAP=25
# DISABLE_AGENT=1
# QUIET=1

# Optional: DataForSEO (https://app.dataforseo.com/api-access) for "Get traction insights" on a lead:
# traffic by country, 12-month trend, top keywords and site tech. About $0.04 per lookup, cached 7 days.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_DAILY_CAP=100

# Optional: Sprouts (company profile, LinkedIn by name, work-email reveal). Every call is on click,
# cached (30 days) and capped; email reveals count towards the monthly lookup cap in Config.
SPROUTS_API_SECRET=
SPROUTS_LOGIN_EMAIL=
SPROUTS_CUSTOMER_ID=
# SPROUTS_DAILY_SEARCH_CAP=25
